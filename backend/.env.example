# ===================================================================
# CoalGuard AI - Backend Render Environment Configuration Template
# ===================================================================

# 1. Render PostgreSQL Database URL (Copied from Render PostgreSQL service dashboard)
# Render format: postgresql://[user]:[password]@[hostname]:[port]/[database]
DATABASE_URL=postgresql://coalguard_user:your_secure_password@dpg-xxxxxx-a.oregon-postgres.render.com/coalguard_db

# 2. Groq AI API Key & Model (Server-side LLM Intelligence)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Deployed Render Frontend Static Site URL (For CORS authorization)
# Example: https://coalguard-ai.onrender.com
FRONTEND_URL=https://coalguard-ai.onrender.com

# 4. Enterprise JWT Authentication Secret
JWT_SECRET=coalguard-enterprise-jwt-token-signing-secret-key-production

# 5. Environment & Port settings
ENVIRONMENT=production
PORT=10000
